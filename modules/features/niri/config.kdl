// 1. Core Integrations & Tweaks
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot-%Y%m%d-%H%M%S.png"

// 2. Startup Applications
spawn-at-startup "qs" "-n"
spawn-at-startup "mako"
spawn-at-startup "swaybg" "-m" "fill" "-i" "~/Pictures/Wallpapers/default.jpg"

// 3. Environment Variables
environment {
    QT_QPA_PLATFORM "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
}

// 4. Cursor
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

// 5. Input Peripheral Options
input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 250
        repeat-rate 40
    }
    touchpad {
        tap
        natural-scroll
    }
}

// 6. Layout and Aesthetic Options
layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.333
        proportion 0.5
        proportion 0.667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#7aa2f7"
        inactive-color "#414868"
    }

    border {
        off
    }
}

// 7. Global Window Management Rules
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// 8. Core Keyboard Shortcuts
binds {
    // Application Launchers
    Mod+Return { spawn "foot"; }
    Mod+Space { spawn "vicinae" "toggle"; }

    // Window Interacting
    Mod+Q { close-window; }
    Mod+M { maximize-column; }
    Mod+F { fullscreen-window; }
    Mod+C { center-column; }

    // Focus Navigation (Horizontal plane)
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }

    // Internal Column Window Navigation (Vertical stack)
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }

    // Moving Windows Around
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }

    // Column Merging / Splitting (Tiling controls)
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+R            { switch-preset-column-width; }

    // Workspace Management
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }

    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    // System Utilities
    Mod+Shift+E { quit; }
    Print { screenshot; }
}
