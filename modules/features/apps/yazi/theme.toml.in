# Generated from config.theme.colours; see yazi.nix for the replacements.
# Icons keep their stock per-file colours; only the generic directory icons
# follow the palette.

[app]
overall = { fg = "#@fg@", bg = "#@bg@" }

[mgr]
cwd = { fg = "#@accent@", bold = true }
find_keyword = { fg = "#@yellow@", bold = true, italic = true, underline = true }
find_position = { fg = "#@purple@", bg = "reset", bold = true, italic = true }
symlink_target = { fg = "#@teal@", italic = true }

marker_copied = { fg = "#@green@", bg = "#@green@" }
marker_cut = { fg = "#@red@", bg = "#@red@" }
marker_marked = { fg = "#@teal@", bg = "#@teal@" }
marker_selected = { fg = "#@yellow@", bg = "#@yellow@" }

count_copied = { fg = "#@bg@", bg = "#@green@" }
count_cut = { fg = "#@bg@", bg = "#@red@" }
count_selected = { fg = "#@bg@", bg = "#@yellow@" }

border_style = { fg = "#@fgDim@" }

[tabs]
active = { fg = "#@bg@", bg = "#@accent@", bold = true }
inactive = { fg = "#@fgMid@", bg = "#@bgRaised@" }

[mode]
normal_main = { fg = "#@bg@", bg = "#@accent@", bold = true }
normal_alt = { fg = "#@accent@", bg = "#@bgRaised@" }
select_main = { fg = "#@bg@", bg = "#@green@", bold = true }
select_alt = { fg = "#@green@", bg = "#@bgRaised@" }
unset_main = { fg = "#@bg@", bg = "#@red@", bold = true }
unset_alt = { fg = "#@red@", bg = "#@bgRaised@" }

[status]
overall = { fg = "#@fg@", bg = "#@bgRaised@" }
perm_sep = { fg = "#@fgDim@" }
perm_type = { fg = "#@green@" }
perm_read = { fg = "#@yellow@" }
perm_write = { fg = "#@red@" }
perm_exec = { fg = "#@teal@" }
progress_label = { bold = true }
progress_normal = { fg = "#@green@", bg = "#@bg@" }
progress_error = { fg = "#@yellow@", bg = "#@red@" }

[which]
border = { fg = "#@accent@" }
cols = 3
cand = { fg = "#@teal@" }
rest = { fg = "#@fgDim@" }
desc = { fg = "#@purple@" }
separator_style = { fg = "#@fgDim@" }

[confirm]
border = { fg = "#@accent@" }
title = { fg = "#@accent@" }
btn_yes = { fg = "#@bg@", bg = "#@green@", bold = true }

[spot]
border = { fg = "#@accent@" }
title = { fg = "#@accent@" }
tbl_col = { fg = "#@accent@" }
tbl_cell = { fg = "#@yellow@", reversed = true }

[notify]
title_info = { fg = "#@green@" }
title_warn = { fg = "#@yellow@" }
title_error = { fg = "#@red@" }

[pick]
border = { fg = "#@accent@" }
active = { fg = "#@purple@", bold = true }

[input]
border = { fg = "#@accent@" }
title = { fg = "#@accent@" }
hint = { fg = "#@fgDim@", italic = true }
selected = { fg = "#@bg@", bg = "#@accent@" }

[cmp]
border = { fg = "#@accent@" }
active = { reversed = true }

[tasks]
border = { fg = "#@accent@" }
hovered = { fg = "#@purple@", bold = true }

[help]
border = { fg = "#@accent@" }
chord = { fg = "#@teal@" }
hovered = { reversed = true, bold = true }

[icon]
prepend_conds = [
  { if = "dir & hovered", text = "󰉋", fg = "#@teal@" },
  { if = "dir", text = "󰉖", fg = "#@accent@" }
]

[filetype]
rules = [
  { mime = "**/image/*", fg = "#@yellow@" },
  { mime = "**/{audio,video}/*", fg = "#@purple@" },
  { mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "#@red@" },
  { mime = "**/application/{pdf,doc,rtf}", fg = "#@teal@" },
  { mime = "vfs/{absent,stale}", fg = "#@fgDim@" },
  { url = "*", is = "orphan", bg = "#@red@" },
  { url = "*", is = "exec", fg = "#@green@" },
  { url = "*", is = "dummy", bg = "#@red@" },
  { url = "*/", is = "dummy", bg = "#@red@" },
  { url = "*/", fg = "#@accent@" }
]
